<div
  id="file-form"
  class="modal-overlay <%= openModal === 'addFile' ? '' : 'hidden' %>"
>
  <div
    class="modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="file-title"
  >
    <div class="modal-stack">
      <div class="modal-header">
        <h1 id="file-title">New File</h1>
        <button
          type="button"
          id="file-close"
          class="icon-button"
          aria-label="Close"
        >
          <i data-lucide="x" class="icon" aria-hidden="true"></i>
        </button>
      </div>
      <form
        action="/folders/<%= folder.id %>/new-file"
        method="post"
        enctype="multipart/form-data"
        class="form-stack"
      >
        <div class="field-group">
          <label for="file" class="field-label">Choose file</label>
          <input
            type="file"
            name="file"
            id="file"
            class="text-field"
            required
          />
        </div>
        <button type="submit" class="button-primary">Upload</button>
      </form>
    </div>
  </div>
</div>
