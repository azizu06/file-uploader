<div
  id="file-form"
  class="modal-overlay <%= openModal === 'addFile' ? '' : 'hidden' %>"
>
  <div
    class="modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="file-title"
  >
    <div class="modal-stack">
      <div class="modal-header">
        <h1 id="file-title">New File</h1>
        <button
          type="button"
          id="file-close"
          class="icon-button"
          aria-label="Close"
        >
          <i data-lucide="x" class="icon" aria-hidden="true"></i>
        </button>
      </div>
      <form
        action="/folders/<%= folder.id %>/new-file"
        method="post"
        enctype="multipart/form-data"
        class="form-stack"
      >
        <div class="field-group">
          <label for="file" class="field-label">Choose file</label>
          <div class="file-upload-control">
            <input
              type="file"
              name="file"
              id="file"
              class="file-input"
              required
            />
            <label for="file" class="file-picker-button">
              <i data-lucide="file-up" class="icon" aria-hidden="true"></i>
              Choose file
            </label>
            <span class="file-upload-name" data-file-name
              >No file selected</span
            >
          </div>
        </div>
        <button type="submit" class="button-primary">Upload</button>
      </form>
    </div>
  </div>
</div>

<script>
  const fileInput = document.getElementById("file");
  const fileName = document.querySelector("[data-file-name]");
  fileInput?.addEventListener("change", () => {
    fileName.textContent = fileInput.files?.[0]?.name || "No file selected";
  });
</script>
