<div id="file-form" class="fixed inset-0 z-50 hidden bg-black/40">
  <div class="mx-auto mt-32 w-[90%] max-w-md rounded-lg">
    <div class="flex flex-col gap-3">
      <div class="flex justify-between">
        <h1>New File</h1>
        <button type="button" id="file-close">X</button>
      </div>
      <form
        action="/files/new"
        method="post"
        enctype="multipart/form-data"
        class="flex flex-col gap-2"
      >
        <div class="flex flex-col gap-0.5">
          <label for="file">Choose file</label>
          <input type="file" name="file" id="file" required />
        </div>
        <button type="submit" class="flex border rounded-xl p-2 justify-center">
          Upload
        </button>
      </form>
    </div>
  </div>
</div>
