<div
  id="delete-modal"
  class="modal-overlay <%= openModal === 'delete' ? '' : 'hidden' %>"
>
  <div
    class="modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="delete-title"
  >
    <div class="modal-stack">
      <div class="modal-header">
        <h1 id="delete-title"></h1>
        <button
          type="button"
          id="delete-close"
          class="icon-button"
          aria-label="Close"
        >
          <i data-lucide="x" class="icon" aria-hidden="true"></i>
        </button>
      </div>
      <form action="" method="post" class="form-stack" id="delete-form">
        <p id="delete-message"></p>
        <button type="submit" class="button-danger button-full">Confirm</button>
      </form>
    </div>
  </div>
</div>
