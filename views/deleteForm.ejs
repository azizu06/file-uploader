<div id="delete-modal" class="fixed inset-0 z-50 hidden bg-black/40">
  <div class="mx-auto mt-32 w-[90%] max-w-md rounded-lg">
    <div class="flex flex-col gap-3">
      <div class="flex justify-between">
        <h1 id="delete-title"></h1>
        <button type="button" id="delete-close">X</button>
      </div>
      <form
        action=""
        method="post"
        class="flex flex-col gap-2"
        id="delete-form"
      >
        <p id="delete-message"></p>
        <button type="submit" class="flex border rounded-xl p-2 justify-center">
          Confirm
        </button>
      </form>
    </div>
  </div>
</div>
