<div id="edit-modal" class="modal-overlay hidden">
  <div
    class="modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="edit-title"
  >
    <div class="modal-stack">
      <div class="modal-header">
        <h1 id="edit-title">Edit Folder</h1>
        <button
          type="button"
          id="edit-close"
          class="icon-button"
          aria-label="Close"
        >
          <i data-lucide="x" class="icon" aria-hidden="true"></i>
        </button>
      </div>
      <form action="" method="post" class="form-stack" id="edit-form">
        <div class="field-group">
          <label for="edit-name" class="field-label">Name</label>
          <input
            type="text"
            name="name"
            id="edit-name"
            class="text-field"
            required
          />
        </div>
        <button type="submit" class="button-primary">Save Changes</button>
      </form>
    </div>
  </div>
</div>
