<div
  id="folder-form"
  class="modal-overlay <%= openModal === 'addFolder' ? '' : 'hidden' %>"
>
  <div
    class="modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="folder-title"
  >
    <div class="modal-stack">
      <div class="modal-header">
        <h1 id="folder-title">Create Folder</h1>
        <button
          type="button"
          id="folder-close"
          class="icon-button"
          aria-label="Close"
        >
          <i data-lucide="x" class="icon" aria-hidden="true"></i>
        </button>
      </div>
      <form
        action="/folders/<%= folder.id %>/new-folder"
        method="post"
        class="form-stack"
      >
        <div class="field-group">
          <label for="name" class="field-label">Name</label>
          <input
            type="text"
            name="name"
            id="name"
            class="text-field"
            required
          />
        </div>
        <button type="submit" class="button-primary">Create Folder</button>
      </form>
    </div>
  </div>
</div>
