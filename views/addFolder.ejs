<div id="folder-form" class="fixed inset-0 z-50 hidden bg-black/40">
  <div class="mx-auto mt-32 w-[90%] max-w-md rounded-lg">
    <div class="flex flex-col gap-3">
      <div class="flex justify-between">
        <h1>Create Folder</h1>
        <button type="button" id="folder-close">X</button>
      </div>
      <form action="/folders/new" method="post" class="flex flex-col gap-2">
        <div class="flex flex-col gap-0.5">
          <label for="name">Name</label>
          <input type="text" name="name" id="name" required />
        </div>
        <button type="submit" class="flex border rounded-xl p-2 justify-center">
          Create Folder
        </button>
      </form>
    </div>
  </div>
</div>
