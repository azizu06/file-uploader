<div class="content-panel">
  <div class="content-header">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/folders/<%= folder.id %>">Home</a>
        <% path.forEach((folder) => { %>
        <span aria-hidden="true">/</span>
        <a href="/folders/<%= folder.id %>"><%= folder.name %></a>
        <% }) %>
      </nav>
      <h1 class="page-title"><%= folder.name %></h1>
    </div>
    <div class="sort-group" aria-label="Sort files">
      <a href="/folders/<%= folder.id %>?sort=name&dir=asc">Name</a>
      <a href="/folders/<%= folder.id %>?sort=size&dir=asc">Size</a>
      <a href="/folders/<%= folder.id %>?sort=date&dir=asc">Date Added</a>
    </div>
  </div>
  <div class="items-list">
    <div class="items-header" aria-hidden="true">
      <span>Name</span>
      <span>Size</span>
      <span>Date Added</span>
      <span>Actions</span>
    </div>
    <% folder.children.forEach((child) => { %>
    <div class="item-row">
      <a href="/folders/<%= child.id %>" class="item-name">
        <i data-lucide="folder" class="icon folder-icon" aria-hidden="true"></i>
        <span><%= child.name %></span>
      </a>
      <span class="item-meta">Folder</span>
      <span class="item-meta"><%= child.createdAt %></span>
      <div class="row-actions">
        <button
          type="button"
          class="button-ghost"
          data-edit-folder
          data-folder-id="<%= child.id %>"
          data-folder-name="<%= child.name %>"
        >
          <i data-lucide="pencil" class="icon" aria-hidden="true"></i>
          Edit
        </button>
        <button
          type="button"
          class="button-danger"
          data-delete-item
          data-delete-type="Folder"
          data-item-id="<%= child.id %>"
        >
          <i data-lucide="trash-2" class="icon" aria-hidden="true"></i>
          Delete
        </button>
      </div>
    </div>
    <% }) %>
    <% folder.files.forEach((file) => { %>
    <div class="item-row">
      <span class="item-name">
        <i data-lucide="file" class="icon file-icon" aria-hidden="true"></i>
        <span><%= file.name %></span>
      </span>
      <span class="item-meta"><%= file.size %></span>
      <span class="item-meta"><%= file.createdAt %></span>
      <div class="row-actions">
        <button type="button" class="button-ghost">
          <i data-lucide="download" class="icon" aria-hidden="true"></i>
          Download
        </button>
        <button
          type="button"
          class="button-danger"
          data-delete-item
          data-delete-type="File"
          data-item-id="<%= file.id %>"
        >
          <i data-lucide="trash-2" class="icon" aria-hidden="true"></i>
          Delete
        </button>
      </div>
    </div>
    <% }) %>
    <% if(folder.children.length === 0 && folder.files.length === 0){ %>
    <div class="empty-state">
      <i data-lucide="folder-open" class="empty-icon" aria-hidden="true"></i>
      <p>This folder is empty.</p>
    </div>
    <% } %>
  </div>
  <%- include("editFolder") %>
  <%- include("deleteForm") %>
</div>

<script>
  const editModal = document.getElementById("edit-modal");
  const editForm = document.getElementById("edit-form");
  const editName = document.getElementById("edit-name");
  const editClose = document.getElementById("edit-close");
  const editBtns = document.querySelectorAll("[data-edit-folder]");
  editBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.folderId;
      const name = btn.dataset.folderName;
      editForm.action = `/folders/${id}/edit`;
      editName.value = name;
      editModal.classList.remove("hidden");
    });
  });
  editClose.addEventListener("click", () => editModal.classList.add("hidden"));
  const deleteModal = document.getElementById("delete-modal");
  const deleteForm = document.getElementById("delete-form");
  const deleteClose = document.getElementById("delete-close");
  const deleteTitle = document.getElementById("delete-title");
  const deleteMsg = document.getElementById("delete-message");
  const deleteBtns = document.querySelectorAll("[data-delete-item]");
  deleteBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.itemId;
      const type = btn.dataset.deleteType;
      deleteTitle.innerText = `Delete ${type}`;
      if (type === "Folder") {
        deleteMsg.innerText =
          "Are you sure you want to delete the current folder and all of its contents?";
      } else {
        deleteMsg.innerText =
          "Are you sure you want to delete the current file?";
      }
      deleteForm.action = `/${type.toLowerCase()}s/${id}/delete`;
      deleteModal.classList.remove("hidden");
    });
  });
  deleteClose.addEventListener("click", () =>
    deleteModal.classList.add("hidden"),
  );
</script>
