<div class="folder-tree">
  <% folders.forEach((folder) => { %>
  <div class="tree-node" data-folder>
    <div class="tree-row" style="--depth: <%= depth %>">
      <% if(folder.children.length > 0){ %>
      <button
        data-folder-toggle
        type="button"
        class="tree-toggle"
        aria-label="Toggle folder"
      >
        <i data-lucide="chevron-right" class="icon" aria-hidden="true"></i>
      </button>
      <% } else { %>
      <span class="tree-toggle-placeholder" aria-hidden="true"></span>
      <% } %>
      <i data-lucide="folder" class="icon folder-icon" aria-hidden="true"></i>
      <a href="/folders/<%= folder.id %>" class="tree-link"
        ><%= folder.name %></a
      >
    </div>
    <div data-folder-children class="hidden">
      <%- include("folderTree.ejs", {folders: folder.children, depth: depth+1})
      %>
    </div>
  </div>
  <% }) %>
</div>
