<div class="flex flex-col gap-2">
  <button id="folder-modal" class="border rounded-xl p-2">New Folder</button>
  <button id="file-modal" class="border rounded-xl p-2">New File</button>
  <div class="flex flex-col gap-0.5">
    <p><%= user.username %></p>
    <%- include("folderTree.ejs", {folders: user.folders, depth: 0}) %>
  </div>
  <%- include("addFolder.ejs") %>
  <%- include("addFile.ejs") %>
</div>

<script>
  const toggles = document.querySelectorAll("[data-folder-toggle]");
  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const parent = toggle.closest("[data-folder]");
      const children = parent.querySelector("[data-folder-children]");
      children?.classList.toggle("hidden");
    });
  });
  const folderBtn = document.getElementById("folder-modal");
  const folderForm = document.getElementById("folder-form");
  const folderClose = document.getElementById("folder-close");
  folderBtn.addEventListener("click", () =>
    folderForm.classList.remove("hidden"),
  );
  folderClose.addEventListener("click", () =>
    folderForm.classList.add("hidden"),
  );
  const fileBtn = document.getElementById("file-modal");
  const fileForm = document.getElementById("file-form");
  const fileClose = document.getElementById("file-close");
  fileBtn.addEventListener("click", () => fileForm.classList.remove("hidden"));
  fileClose.addEventListener("click", () => fileForm.classList.add("hidden"));
</script>
