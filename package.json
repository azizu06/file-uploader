{
  "name": "file-uploader",
  "version": "1.0.0",
  "description": "File uploader app",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node routes/app.js",
    "db:init": "node db/init.js",
    "dev:server": "nodemon routes/app.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "concurrently \"npm run dev:server\" \"npm run watch:css\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizu06/file-uploader.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/azizu06/file-uploader/issues"
  },
  "homepage": "https://github.com/azizu06/file-uploader#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-ejs": "^1.0.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@quixo3/prisma-session-store": "^3.1.19",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "lucide-react": "^1.8.0",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0"
  }
}
